# CampusOverflow 部署环境变量示例
#
# 用法：
#   cp deploy/.env.example deploy/.env      # Windows: Copy-Item deploy\.env.example deploy\.env
#   然后按需修改 deploy/.env 中的值
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
#
# docker-compose.yml 里每个变量都写了 ${VAR:-默认值}，因此不提供 .env 也能用开发默认值启动；
# 对外演示或长期运行时，请务必复制本文件并修改密码与密钥。

# --- 数据库 ---
# MySQL root 密码，仅用于容器初始化与健康检查
MYSQL_ROOT_PASSWORD=root_dev_pwd
# 应用连接用的账号密码（init 时会创建 campus 用户）
DB_PASSWORD=campus_dev_pwd

# --- 运行 profile ---
# prod,demo ：生产配置 + 加载演示数据（课程演示用这个，界面有内容可看）
# prod      ：生产配置，不加载演示数据（真实部署用这个）
# dev       ：本地开发配置，容器部署不要用
SPRING_PROFILES=prod,demo

# --- 安全 ---
# 字段加密主密钥（AES-128，Base64 编码的 16 字节）。
# 下面的值是仓库自带的开发密钥，请勿用于真实环境；生产环境请重新生成：
#   openssl rand -base64 16
CO_FIELD_KEY=GB7LwwDgcWpslCMsYtIkTbDrzER+IbjJwhtSu7LPz1I=

# 会话 Cookie 是否只在 HTTPS 下发送。本地 http://localhost 演示时必须为 false，
# 一旦通过 HTTPS 对外发布，必须改为 true。
COOKIE_SECURE=false

# --- 可观测性（仅 --profile observability 时生效）---
GRAFANA_PASSWORD=admin

# --- 宿主机端口（默认值，冲突时改这里）---
BACKEND_PORT=8080
WEB_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379
