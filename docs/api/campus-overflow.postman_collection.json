            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": null,\n  \"title\": \"MySQL ngram 全文索引对中文短词检索不生效（已补充版本信息）\",\n  \"body\": \"MySQL 8.0.33，表用 WITH PARSER ngram，ngram_token_size 默认 2。检索「数据库」只命中完整包含该词的文档，英文单词正常。已确认 innodb_ft_enable_stopword=0，想请教分词粒度与最小检索长度的正确配法。\",\n  \"tags\": [\"mysql\", \"全文检索\", \"中文\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "{{questionId}}"]
