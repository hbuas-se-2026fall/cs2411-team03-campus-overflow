                "type": "text/javascript",
                "exec": ["pm.test('200 资料已更新', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"{{regDisplay}}\",\n  \"email\": \"{{regEmail}}\",\n  \"college\": \"湖北文理学院\",\n  \"className\": \"计算机2411\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": []
