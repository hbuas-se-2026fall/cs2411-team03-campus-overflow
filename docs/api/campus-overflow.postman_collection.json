          "const csrfCookie = pm.cookies.get('XSRF-TOKEN');",
          "const csrfVar = pm.collectionVariables.get('csrf');",
          "if (csrfCookie || csrfVar) {",
          "  pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: csrfCookie || csrfVar });",
          "}"
        ]
      }
