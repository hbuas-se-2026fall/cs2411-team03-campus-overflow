          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"ngram 的 token size 在初始化时固化，2 表示按两字切分；查询词少于 token size 时匹配不到，先把 ngram_token_size 调到 1 再重建索引，或在应用层对短词走 LIKE 兜底。修改 my.cnf 后需要 OPTIMIZE TABLE 重建全文索引才会生效。\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/answers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "{{questionId}}", "answers"]
